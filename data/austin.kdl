            address="3805 W 35th St., Austin, Texas 78703"
            acres=(f64)23.331
            kind="Special"

        park id="michael-butler-park"
            name="Michael Butler Park at Town Lake Metro Park"
            address="1000 Barton Springs Rd., Austin, Texas 78704"
            acres=(f64)20.3
            kind="Metropolitan"

        park id="michael-butler-shores"
            name="Michael Butler Shores at Town Lake Metro Park"
            address="200 S Lamar Blvd., Austin, Texas 78704"
            acres=(f64)28.65
            kind="Metropolitan"

        park id="northern-walnut-creek-greenbelt"
            name="Northern Walnut Creek Greenbelt"
            address="2611 Park Bend Rd., Austin, Texas 78758"
            acres=(f64)428.2080
            kind="Greenbelt"

        park id="onion-creek-metro"
            name="Onion Creek Metropolitan Park"
            address="8652 Nuckols Crossing Rd., Austin, Texas 78744"
            acres=(f64)650.3721
            kind="Metropolitan"

        park id="onion-creek-greenbelt"
            name="Onion Creek Greenbelt"
            address="7004 Onion Creek Dr., Austin, Texas 78744"
            acres=(f64)320.0954
            kind="Greenbelt"
            off_leash_area=#true
            off_leash_source="offleash_list"

        park id="shoal-creek-greenbelt"
            name="Shoal Creek Greenbelt"
            address="2600 N Lamar Blvd., Austin, Texas 78705"
            acres=(f64)94.0926
            kind="Greenbelt"
            off_leash_area=#true
            off_leash_source="offleash_list"

        park id="waller-creek-greenbelt"
            name="Waller Creek Greenbelt"
            address="703 E 6th St., Austin, Texas 78701"
            acres=(f64)7.2496
            kind="Greenbelt"

        park id="walnut-creek-metro"
            name="Walnut Creek Metropolitan Park"
            address="12138 N Lamar Blvd, Austin, Texas 78758"
            acres=(f64)295.9500
            kind="Metropolitan"
            off_leash_area=#true
            off_leash_source="offleash_list"

        park id="walnut-creek-sports"
            name="Walnut Creek Sports Park"
            address="7800 Johnny Morris Rd., Austin, Texas 78724"
            acres=(f64)217.2150
            kind="Special"

        park id="vic-mathias-shores"
            name="Vic Mathias Shores at Town Lake Metropolitan Park"
            address="700 W Riverside Dr., Austin, Texas 78704"
            acres=(f64)5.76
            kind="Metropolitan"

        park id="volma-overton-sr"
            name="Volma Overton,Sr. at Town Lake Metropolitan Park"
            address="1200 Cesar Chavez St., Austin, Texas 78703"
            acres=(f64)65.41
            kind="Metropolitan"

        // /- park id="future-example" name="This is ignored" acres=999
    }

    stats {
        parks_listed (i32)18
        total_acres_listed (f64)4177.5202
        note="Totals are computed from the parks listed in this file (not from the full City inventory)."
    }

    libraries source="apl_branches" system="Austin Public Library" {
