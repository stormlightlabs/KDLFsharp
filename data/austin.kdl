/- kdl-version 2
(meta)dataset "austin-parks-and-libraries"
    version="1.0.0"
    generated_at=(date)"2025-12-16"
    license="CC-BY-4.0"
{
    // --- Provenance / sources (URLs shown with raw-string syntax) ---
    sources {
        source id="parks_directory"
            name="City of Austin Park Directory"
            url=#"https://www.austintexas.gov/page/park-directory"#
            fields="park name, address, acres"

        source id="apl_branches"
            name="Austin Public Library branch pages"
            url=#"https://library.austintexas.gov/"#
            fields="address, phone, weekly hours"

        source id="offleash_list"
            name="Austin Parks Foundation: off-leash areas"
            url=#"https://austinparks.org/dog-parks/"#
            fields="off-leash presence (informational; third-party)"
            reliability_note="Not an official City inventory; treat as a helpful hint."
    }

    // --- A rich multi-line string (dedented by closing quotes) ---
    about """
        This KDL file is both:
          1) a real-ish mini catalog of Austin parks + APL branches
          2) a “kitchen sink” syntax example for KDL 2.0.0

        Notes:
        - Park acres/addresses are taken from the City of Austin park directory.
        - Library hours/phones are taken from APL branch pages.
        - Off-leash flags are taken from Austin Parks Foundation (third-party).
        """

    /* Nested multiline comments are allowed.
       /* Like this. */
       End of nested comment. */

    // --- Quick feature demo block (doesn’t pretend to be city data) ---
    kdl_features_demo {
        // Numbers: decimal, exponent, hex, binary w/ underscores, keyword numbers
        numbers
            int=(i32)42
            big=(i64)9_223_372_036_854_775_807
            float=(f64)1.25e3
            hex=0xDEAD_BEEF
            bin=0b1010_0101
            pos_inf=#inf
            neg_inf=#-inf
            nan=#nan

        // Booleans + null
        flags enabled=#true disabled=#false missing=#null

        // Strings: identifier, quoted, raw, multi-line, raw multi-line
        strings
            identifier_string=hello_world
            quoted_string="César Chávez"
            raw_string=#"backslashes \ stay \ literal \ here"# // no escapes
            multi_line """
                Line 1: a "normal" multiline string (escapes work)
                Line 2: tabs \t and newlines \n are escapes in quoted contexts
                """
            raw_multi_line #"""
                Raw multiline: nothing is escaped here.
                You can paste JSON, bash, or regex without backslash pain: \d+\s+
                """#

        // Line continuation: one node spread across lines
        continued_example 1 2 \
            3 4 5 \
            key="still same node"
            done=#true

        // Slashdash comments: semantically remove whole nodes/args/props from the data model
        /- old_setting "this node is ignored entirely"
        slashdash_examples 1 /- 2 3 4  // argument “2” is ignored
        slashdash_prop_demo a=1 /- b=2 c=3 // property b=2 is ignored

        // Semicolon terminators
        single_line_children { a; b; c; };
    }

    parks source="parks_directory" city="Austin" state="TX" {
        // Each `park` node uses a stable-ish id, plus official name/address/acres.
        park id="zilker-metro"
            name="Zilker Metropolitan Park"
            address="2100 Barton Springs Rd., Austin, Texas 78746"
            acres=(f64)274.6150
            kind="Metropolitan"
            off_leash_area=#true
            off_leash_source="offleash_list"
        {
            // A key with spaces (string keys are allowed)
            "curator notes"="Major central park; acres/address from City directory."
        }

        park id="emma-long-metro"
            name="Emma Long Metropolitan Park"
            address="1600 City Park Rd., Austin, Texas 78730"
            acres=(f64)1147.2216
            kind="Metropolitan"
            off_leash_area=#true
            off_leash_source="offleash_list"

        park id="pease-district"
            name="Pease District Park"
            address="1100 Kingsbury St., Austin, Texas 78703"
            acres=(f64)41.4897
            kind="District"

        park id="johnson-creek-greenbelt"
